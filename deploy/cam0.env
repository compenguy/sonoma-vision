# /etc/sonoma-vision/cam0.env
SONOMA_DEVICE=/dev/video0
# `local`: the robot program's NT server on this controller.
SONOMA_NT_SERVER=local
SONOMA_ARGS=--width 1280 --height 720 --fps 60
# To serve a camera stream for dashboards, add for example:
#   --stream --stream-scale 2 --stream-overlay
# For poses: the camera's calibration and its pose on the robot, for example:
#   --calibration /etc/sonoma-vision/cam0-calibration.json --robot-to-camera 0.3,0,0.5,0,-15,0
