# One instance per camera: `systemctl enable --now sonoma-vision@cam0` reads the shared
# /etc/sonoma-vision/sonoma-vision.toml, then /etc/sonoma-vision/cam0.toml, whose values win.
[Unit]
Description=sonoma-vision AprilTag processor (%i)
After=network.target

[Service]
ExecStart=/usr/local/bin/sonoma-vision --config /etc/sonoma-vision/sonoma-vision.toml --config /etc/sonoma-vision/%i.toml
Restart=always
RestartSec=2
# Run unprivileged; the video group grants camera access.
DynamicUser=yes
SupplementaryGroups=video
# Favour frame processing over background work on the controller.
Nice=-5

[Install]
WantedBy=multi-user.target
